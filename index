let gbVoice=null;
function pickVoice(){
  const vs=speechSynthesis.getVoices();
  gbVoice = vs.find(v=>v.lang==='en-GB'&&/Sonia|Libby|Kate|Female|Google UK English Female/i.test(v.name))
         || vs.find(v=>v.lang==='en-GB')
         || vs.find(v=>v.lang.startsWith('en')) || null;
}
