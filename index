<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ms. Emma · AI 英语外教</title>
<!--
  ============================================================
  使用说明：
  ★ 麦克风在 Claude 预览窗口中被沙箱禁用（不是你的设备问题）。
    请下载本文件，用 Chrome 或 Edge 双击打开，允许麦克风权限即可。

  独立使用（脱离 Claude）：
  1. 申请 API key（推荐 DeepSeek：platform.deepseek.com，注册送额度）
  2. 打开页面 → 家长管理 → AI 接口设置：选 DeepSeek，粘贴 key，
     点"测试连接"成功后保存即可，无需修改任何代码。
  （key 保存在本机浏览器 localStorage；给多台设备用或正式上线时，
   建议加一个中转服务把 key 放到服务端。）
  ============================================================
-->
<style>
:root{
  --paper:#FBFBF8; --ink:#22334D; --navy:#2C4A7C; --navy-deep:#1D3357;
  --sky:#EAF1FB; --sky-line:#C9D9F0; --red:#D6493E; --red-deep:#B03328;
  --butter:#FFF6DC; --butter-line:#EFD79A; --amber:#8A6206;
  --green:#2E7D52; --green-bg:#E7F4EC; --teams-green:#6BB700;
  --muted:#7A8699; --line:#E4E7EC; --card:#FFFFFF;
  --call-bg:#171B22; --call-tile:#242E44; --call-bar:#10141B;
  --serif:Georgia,'Times New Roman',serif;
  --sans:-apple-system,'PingFang SC','Microsoft YaHei','Segoe UI',sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{background:var(--paper);color:var(--ink);font-family:var(--sans);min-height:100vh}
.wrap{max-width:760px;margin:0 auto;padding:20px 16px 40px}
h1{font-size:26px;font-weight:700;color:var(--navy-deep)}
.sub{color:var(--muted);font-size:14px;margin-top:4px}
.hidden{display:none!important}
button{font-family:var(--sans);cursor:pointer;border:none;background:none;font-size:15px}
.btn{padding:9px 18px;border-radius:10px;border:1.5px solid var(--line);background:#fff;color:var(--ink)}
.btn:hover{border-color:var(--navy)}
.btn-primary{background:var(--navy);color:#fff;border-color:var(--navy)}
.btn-primary:hover{background:var(--navy-deep)}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px}
.banner{background:var(--butter);border:1px solid var(--butter-line);color:var(--amber);border-radius:10px;padding:10px 14px;font-size:14px;margin-bottom:12px;line-height:1.6}
.banner.err{background:#FDEBEA;border-color:#F0B6B1;color:var(--red-deep)}

/* ---------- 首页 ---------- */
.brand{display:flex;align-items:center;gap:14px}
.brand .mini-ava{width:56px;height:56px;flex-shrink:0}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px}
.topic{background:var(--card);border:1.5px solid var(--line);border-radius:14px;padding:16px 14px;text-align:left;transition:.15s;display:flex;flex-direction:column;gap:6px}
.topic:hover{border-color:var(--navy);transform:translateY(-2px);box-shadow:0 4px 14px rgba(44,74,124,.10)}
.topic .emo{font-size:28px;line-height:1}
.topic .en{font-family:var(--serif);font-size:16px;font-weight:700;color:var(--navy-deep)}
.topic .cn{font-size:13px;color:var(--muted)}
.topic .tag{font-size:12px;color:var(--navy);background:var(--sky);border-radius:6px;padding:2px 8px;align-self:flex-start;margin-top:2px}
.section-label{font-size:13px;color:var(--muted);letter-spacing:.08em;margin:26px 0 10px;text-transform:uppercase}

/* ---------- Teams 风格通话界面 ---------- */
.call{position:fixed;inset:0;background:var(--call-bg);z-index:50;display:flex;flex-direction:column;color:#E8ECF3}
.call-top{display:flex;align-items:center;justify-content:space-between;padding:12px 18px;font-size:14px;color:#AEB8C9}
.call-top .t-name{font-family:var(--serif);font-size:16px;color:#fff}
.call-timer{font-variant-numeric:tabular-nums;background:rgba(255,255,255,.08);border-radius:8px;padding:4px 10px}
.call-timer.warn{color:#FF8A80}
.stage{flex:1;display:flex;align-items:center;justify-content:center;position:relative;padding:8px 16px;min-height:0}
.tile{background:var(--call-tile);border-radius:16px;position:relative;display:flex;align-items:center;justify-content:center;transition:box-shadow .2s}
.tile-emma{width:min(430px,86vw);aspect-ratio:4/3}
.tile-emma svg{width:62%;height:auto}
.tile-me{position:absolute;right:22px;bottom:18px;width:110px;aspect-ratio:4/3;background:#2E3540;font-size:38px}
.tile .name{position:absolute;left:10px;bottom:8px;font-size:12px;background:rgba(0,0,0,.45);border-radius:6px;padding:3px 8px;color:#fff}
.tile.speaking{box-shadow:0 0 0 3px var(--teams-green)}
.tile.listening{box-shadow:0 0 0 3px var(--teams-green);animation:glow 1.2s infinite}
@keyframes glow{0%,100%{box-shadow:0 0 0 3px var(--teams-green)}50%{box-shadow:0 0 0 7px rgba(107,183,0,.35)}}
/* 卡通嘴部动画 */
.mouth-open{opacity:0;transform-origin:60px 78px}
.tile.speaking .mouth-open{opacity:1;animation:talk .32s infinite alternate}
.tile.speaking .mouth-smile{opacity:0}
@keyframes talk{from{transform:scaleY(.25)}to{transform:scaleY(1)}}
/* 字幕区 */
.cap-zone{padding:6px 18px 4px;text-align:center;min-height:112px}
.cap-you{font-size:13px;color:#8FA0B8;margin-bottom:6px;min-height:17px}
.cap-text{font-family:var(--serif);font-size:19px;line-height:1.5;color:#fff;max-width:600px;margin:0 auto}
.cap-text .spk{font-size:16px}
.cap-tip{max-width:600px;margin:8px auto 0;background:rgba(255,214,102,.14);border:1px solid rgba(255,214,102,.35);color:#FFD666;border-radius:10px;padding:7px 12px;font-size:13.5px;line-height:1.6}
.cap-tip b{font-family:var(--serif)}
.status{font-size:12.5px;color:#8FA0B8;margin-top:6px;min-height:16px}
/* 控制栏 */
.ctrl-bar{background:var(--call-bar);padding:12px 10px 14px;display:flex;justify-content:center;gap:26px}
.ctl{display:flex;flex-direction:column;align-items:center;gap:5px;color:#AEB8C9;font-size:11.5px}
.ctl .c-btn{width:52px;height:52px;border-radius:50%;background:#2A3140;color:#E8ECF3;font-size:21px;display:flex;align-items:center;justify-content:center;transition:.15s}
.ctl .c-btn:hover{background:#39435A}
.ctl .c-btn.on{background:var(--teams-green);color:#fff}
.ctl .c-btn.mic-btn{width:66px;height:66px;background:var(--red);font-size:27px;user-select:none;touch-action:none;box-shadow:0 4px 16px rgba(214,73,62,.4)}
.ctl .c-btn.mic-btn:active,.ctl .c-btn.mic-btn.listening{background:var(--red-deep);transform:scale(1.08)}
.ctl .c-btn.mic-btn.listening{animation:ring 1.1s infinite}
@keyframes ring{0%{box-shadow:0 0 0 0 rgba(214,73,62,.5)}100%{box-shadow:0 0 0 20px rgba(214,73,62,0)}}
.ctl .c-btn.mic-btn:disabled{background:#454C59;box-shadow:none;cursor:not-allowed;transform:none;animation:none}
.ctl .c-btn.hang{background:#C4314B}
.ctl .c-btn.hang:hover{background:#A5293F}
.kb-row{display:flex;gap:8px;padding:0 18px 10px;max-width:640px;margin:0 auto;width:100%}
.kb-row input{flex:1;background:#232A38;border:1.5px solid #39435A;border-radius:10px;color:#E8ECF3;padding:10px 12px;font-size:15px}
.kb-row input::placeholder{color:#6B7891}
/* 记录抽屉 */
.panel{position:absolute;top:0;right:0;bottom:0;width:min(360px,100vw);background:#fff;color:var(--ink);display:flex;flex-direction:column;box-shadow:-8px 0 24px rgba(0,0,0,.35)}
.panel-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line);font-weight:600}
#msgs{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:12px}
.row{display:flex;gap:8px;align-items:flex-start}
.row.me{justify-content:flex-end}
.bubble{max-width:85%;border-radius:12px;padding:9px 13px;font-size:14.5px;line-height:1.5}
.bubble.tutor{background:var(--sky);border:1px solid var(--sky-line);font-family:var(--serif)}
.bubble.me{background:var(--navy);color:#fff}
.bubble .meta{font-size:11px;color:var(--muted);font-family:var(--sans);margin-top:4px}
.bubble.me .meta{color:rgba(255,255,255,.75)}
.spk{background:none;border:none;font-size:14px;margin-left:5px;cursor:pointer;vertical-align:-1px}
.tipcard{background:var(--butter);border:1px solid var(--butter-line);border-radius:10px;padding:8px 12px;font-size:13px;color:var(--amber);max-width:85%;line-height:1.6}

/* ---------- 总结页 / 家长页 ---------- */
.sum-card{background:var(--card);border:1.5px solid var(--line);border-radius:16px;padding:24px}
.sum-title{font-family:var(--serif);font-size:22px;color:var(--navy-deep);margin-bottom:6px}
.stats{display:flex;gap:12px;margin:18px 0}
.stat{flex:1;background:var(--sky);border-radius:12px;padding:14px;text-align:center}
.stat .n{font-size:26px;font-weight:700;color:var(--navy-deep)}
.stat .l{font-size:13px;color:var(--muted);margin-top:2px}
.fix-item{background:var(--butter);border:1px solid var(--butter-line);border-radius:10px;padding:10px 14px;margin-top:8px;font-size:14px;color:var(--amber);line-height:1.6}
.sum-msg{background:var(--green-bg);border-radius:12px;padding:14px;color:var(--green);font-size:15px;line-height:1.7;margin-top:16px}
.form-row{margin-bottom:14px}
.form-row label{display:block;font-size:13px;color:var(--muted);margin-bottom:5px}
.form-row input,.form-row textarea,.form-row select{width:100%;border:1.5px solid var(--line);border-radius:10px;padding:9px 12px;font-size:15px;font-family:var(--sans);background:#fff;color:var(--ink)}
.form-row textarea{min-height:70px;resize:vertical}
.custom-item{display:flex;justify-content:space-between;align-items:center;background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px 14px;margin-top:8px;font-size:14px}
.del{color:var(--red);font-size:13px}
@media (max-width:520px){.tile-me{width:84px;right:12px;bottom:12px}.ctrl-bar{gap:16px}.cap-text{font-size:17px}}
</style>
</head>
<body>
<div class="wrap">

  <!-- ============ 首页 ============ -->
  <div id="view-home">
    <div class="topbar">
      <div class="brand">
        <div class="mini-ava" id="home-ava"></div>
        <div><h1>Ms. Emma 英语角 🇬🇧</h1>
        <p class="sub">选一个话题，和 Emma 老师视频通话 3–5 分钟</p></div>
      </div>
      <button class="btn" onclick="showView('parent')">👪 家长管理</button>
    </div>
    <div id="iframe-warn" class="banner err hidden">🎙 <b>当前处于 Claude 预览窗口，麦克风被沙箱禁用</b>（不是你的设备问题）。请点击下载本文件，用 Chrome / Edge 双击打开后即可正常语音对话。</div>
    <div id="key-warn" class="banner err hidden">🔑 <b>本页面已脱离 Claude 独立运行</b>：语音功能正常，但 AI 对话需要先配置接口。请进入 <b>家长管理 → AI 接口设置</b>，选择 DeepSeek 并填入 API key（在 platform.deepseek.com 注册获取，新用户送免费额度），点"测试连接"成功后即可使用。</div>
    <div id="file-warn" class="banner hidden">📂 当前以本地文件方式打开：浏览器安全规则会<b>每次都询问麦克风权限</b>，无法记忆。想免弹窗：① 用同文件夹里的「启动Emma.bat」打开（自动授权）；② 或将本页部署到网上获得正式网址（一次允许、永久记忆）。</div>
    <div id="browser-warn" class="banner hidden">⚠️ 当前浏览器不支持语音识别，请使用 <b>Chrome</b> 或 <b>Edge</b> 浏览器打开。</div>
    <div class="section-label">基础话题 Basics</div>
    <div class="grid" id="grid-basic"></div>
    <div class="section-label">进阶话题 More practice</div>
    <div class="grid" id="grid-adv"></div>
    <div class="section-label" id="custom-label" style="display:none">自定义话题 My topics</div>
    <div class="grid" id="grid-custom"></div>
  </div>

  <!-- ============ Teams 风格通话页 ============ -->
  <div id="view-chat" class="call hidden">
    <div class="call-top">
      <span class="t-name" id="chat-topic-name"></span>
      <span class="call-timer" id="timer">00:00</span>
    </div>
    <div class="stage">
      <div class="tile tile-emma" id="tile-emma">
        <span class="ava-slot" id="call-ava" style="display:contents"></span>
        <span class="name">Ms. Emma 🇬🇧</span>
      </div>
      <div class="tile tile-me" id="tile-me">🙋<span class="name">我</span></div>
      <div class="panel hidden" id="panel">
        <div class="panel-head">对话记录 <button class="btn" style="padding:4px 12px" onclick="togglePanel()">关闭</button></div>
        <div id="msgs"></div>
      </div>
    </div>
    <div class="cap-zone">
      <div class="cap-you" id="cap-you"></div>
      <div class="cap-text" id="cap-text">正在接通 Emma…</div>
      <div class="cap-tip hidden" id="cap-tip"></div>
      <div class="status" id="status"></div>
    </div>
    <div class="kb-row hidden" id="kb-row">
      <input id="kb-input" placeholder="Type your answer in English..." onkeydown="if(event.key==='Enter')sendKb()">
      <button class="btn btn-primary" onclick="sendKb()">发送</button>
    </div>
    <div class="ctrl-bar">
      <div class="ctl"><button class="c-btn" id="btn-auto" onclick="toggleAuto()" aria-label="连续对话">🔁</button>连续对话</div>
      <div class="ctl"><button class="c-btn mic-btn" id="mic" aria-label="按住说话">🎙</button>按住说话</div>
      <div class="ctl"><button class="c-btn" onclick="togglePanel()" aria-label="对话记录">💬</button>记录</div>
      <div class="ctl"><button class="c-btn" id="btn-kb" onclick="toggleKb()" aria-label="打字回答">⌨️</button>打字</div>
      <div class="ctl"><button class="c-btn hang" onclick="hangUp()" aria-label="结束通话">✕</button>挂断</div>
    </div>
  </div>

  <!-- ============ 总结页 ============ -->
  <div id="view-summary" class="hidden">
    <div class="sum-card">
      <div class="sum-title">Well done! 今日练习小结 🌟</div>
      <p class="sub" id="sum-topic"></p>
      <div class="stats">
        <div class="stat"><div class="n" id="stat-turns">0</div><div class="l">开口次数</div></div>
        <div class="stat"><div class="n" id="stat-time">0:00</div><div class="l">练习时长</div></div>
        <div class="stat"><div class="n" id="stat-fixes">0</div><div class="l">纠正要点</div></div>
      </div>
      <div id="sum-fix-list"></div>
      <div class="sum-msg" id="sum-msg"></div>
      <div style="display:flex;gap:10px;margin-top:20px">
        <button class="btn btn-primary" onclick="showView('home')">返回话题列表</button>
        <button class="btn" onclick="retryTopic()">再练一次这个话题</button>
      </div>
    </div>
  </div>

  <!-- ============ 家长页 ============ -->
  <div id="view-parent" class="hidden">
    <div class="topbar">
      <h1>家长管理 · 添加话题</h1>
      <button class="btn" onclick="showView('home')">← 返回</button>
    </div>
    <div class="sum-card" style="margin-bottom:20px">
      <div class="sum-title" style="font-size:18px">AI 接口设置</div>
      <p class="sub" style="margin-bottom:14px">在 claude.ai 内试用无需设置。下载独立使用时：选择 DeepSeek，粘贴 API key（platform.deepseek.com 注册获取），点"测试连接"。key 只保存在本机浏览器中，不会上传。</p>
      <div class="form-row"><label>服务商</label>
        <select id="s-provider" onchange="providerPreset()">
          <option value="claude">Claude 预览环境（仅在 claude.ai 内可用）</option>
          <option value="deepseek">DeepSeek（推荐，国内直连）</option>
          <option value="custom">其他 OpenAI 兼容接口（智谱 / Moonshot 等）</option>
        </select></div>
      <div class="form-row"><label>API Key</label><input id="s-key" type="password" placeholder="sk-..."></div>
      <div class="form-row"><label>接口地址</label><input id="s-base" placeholder="https://api.deepseek.com/v1/chat/completions"></div>
      <div class="form-row"><label>模型名</label><input id="s-model" placeholder="deepseek-chat"></div>
      <div class="form-row"><label>语音识别语言（"没听清"较多时可切换美式试试）</label>
        <select id="s-lang"><option value="en-GB">英式 en-GB</option><option value="en-US">美式 en-US（对中式口音更宽容）</option></select></div>
      <button class="btn btn-primary" onclick="saveApiCfg()">保存设置</button>
      <button class="btn" style="margin-left:8px" onclick="testApiCfg()">测试连接</button>
      <span class="sub" id="cfg-tip" style="margin-left:10px"></span>
    </div>
    <div class="sum-card">
      <div class="form-row"><label>话题英文名（如 My Hometown）</label><input id="f-en"></div>
      <div class="form-row"><label>话题中文名</label><input id="f-cn"></div>
      <div style="display:flex;gap:12px">
        <div class="form-row" style="flex:1"><label>图标 emoji</label><input id="f-emo" value="⭐" maxlength="4"></div>
        <div class="form-row" style="flex:1"><label>时长（分钟）</label><select id="f-min"><option>3</option><option selected>4</option><option>5</option></select></div>
      </div>
      <div class="form-row"><label>引导问题（每行一个，Emma 会照此提问）</label><textarea id="f-q" placeholder="Where is your hometown?&#10;What is it famous for?"></textarea></div>
      <div class="form-row"><label>重点词汇（用逗号分隔，可选）</label><input id="f-v" placeholder="hometown, famous, beautiful"></div>
      <button class="btn btn-primary" onclick="saveTopic()">保存话题</button>
      <span class="sub" id="save-tip" style="margin-left:10px"></span>
    </div>
    <div class="section-label">已添加的话题</div>
    <div id="custom-list"><p class="sub">还没有自定义话题</p></div>
  </div>
</div>

<script>
/* ================== 配置区 ================== */
/* 无需手改代码：下载独立使用时，在页面"家长管理 → AI 接口设置"中填写即可 */
let CONFIG = {
  provider: 'claude',          // claude = 仅在 claude.ai 预览内可用；deepseek/custom 需 key
  apiBase: 'https://api.deepseek.com/v1/chat/completions',
  apiKey: '',
  model: 'deepseek-chat',
  sttLang: 'en-GB'             // 识别语言；识别率不佳可改 'en-US'
};
const PRESET_DS={base:'https://api.deepseek.com/v1/chat/completions',model:'deepseek-chat'};
const IN_CLAUDE = (window.self!==window.top);   // Claude 预览运行在 iframe 中

/* ================== Emma 卡通头像（内嵌 SVG，说话时嘴动） ================== */
const EMMA_SVG = `
