function speak(text,rate,onend){
  if(!('speechSynthesis' in window)){ if(onend)onend(); return; }
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(text);
  if(gbVoice)u.voice=gbVoice; u.lang='en-GB'; u.rate=rate||0.95; u.pitch=1.02;
  $('tile-emma').classList.add('speaking');
  u.onend=u.onerror=()=>{ $('tile-emma').classList.remove('speaking'); if(onend)onend(); };
  speechSynthesis.speak(u);
}
