function parseAI(raw){
  try{ return JSON.parse(raw.replace(/```json|```/g,'').trim()); }
  catch(e){ return {reply:raw.slice(0,200),correction:null,end:false,summary_cn:''}; }
}

async function askAI(userText){
  busy=true; mic.disabled=true;
  if(userText!==null){
    logMe(userText); $('cap-you').textContent='你说：'+userText; turns++;
    let content=userText;
    if((Date.now()-startTs)/1000>=cur.min*60&&!ended)content+='\n[TIME_UP]';
    history.push({role:'user',content});
  }else{
    history.push({role:'user',content:'[START] Please greet the student and ask your first question about the topic.'});
  }
  $('cap-text').innerHTML='<span style="color:#8FA0B8;font-style:italic">Emma is thinking…</span>';
  setTip(null);
  try{
    const raw=await callLLM(history);
    const ai=parseAI(raw);
    history.push({role:'assistant',content:raw});
    setCaption(ai.reply); logTutor(ai.reply);
    if(ai.correction&&ai.correction.better){fixes.push(ai.correction);setTip(ai.correction);logTip(ai.correction);}
    const done=!!ai.end;
    speak(ai.reply,0.95,()=>{
      busy=false;
      if(done){ended=true;setTimeout(()=>showSummary(ai.summary_cn),900);return;}
      mic.disabled=false;
      $('status').textContent=autoMode?'自动聆听中…直接开口回答':'按住红色按钮（或空格键）说话，说完再松开；也可点 ⌨️ 打字';
      if(autoMode)setTimeout(()=>{if(!busy&&!ended)startListen();},350);
    });
  }catch(e){
    busy=false; mic.disabled=false;
    $('cap-text').textContent='连接出错了';
    $('status').textContent='⚠️ '+e.message;
  }
}
function sendUser(t){ if(busy||ended)return; $('status').textContent=''; askAI(t); }

