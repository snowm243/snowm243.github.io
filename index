/* 一次性申请麦克风并保持占用：避免 file:// 下每次识别都弹授权、按住时来不及说话 */
let micStream=null;
async function ensureMic(){
  if(micStream)return true;
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia)return true; // 交给识别自行申请
  try{
    $('status').textContent='请在弹窗中点击"允许"使用麦克风（每次打开页面只需一次）';
    micStream=await navigator.mediaDevices.getUserMedia({audio:true});
    $('status').textContent='麦克风已就绪 ✓ 按住红色按钮说话';
    return true;
  }catch(e){
    $('status').textContent='⚠️ 麦克风被拒绝：请点地址栏左侧图标，把麦克风改为"允许"后刷新';
    return false;
  }
}
function toggleKb(){ $('kb-row').classList.toggle('hidden');
  if(!$('kb-row').classList.contains('hidden'))$('kb-input').focus(); }
function sendKb(){ const t=$('kb-input').value.trim(); if(!t)return;
  $('kb-input').value=''; sendUser(t); }
const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
if(!SR)$('browser-warn').classList.remove('hidden');
if(window.self!==window.top)$('iframe-warn').classList.remove('hidden');
if(location.protocol==='file:')$('file-warn').classList.remove('hidden');
let rec=null,listening=false,busy=false;
function startListen(){
  if(!SR||listening||busy||ended)return;
  if(navigator.mediaDevices&&navigator.mediaDevices.getUserMedia&&!micStream){
    ensureMic(); $('status').textContent='正在申请麦克风…允许后请再按住说话'; return; }
  speechSynthesis.cancel(); $('tile-emma').classList.remove('speaking');
  rec=new SR(); rec.lang=CONFIG.sttLang; rec.interimResults=true; rec.maxAlternatives=1;
  let finalText='';
  rec.onresult=e=>{ let interim='';
    for(let i=e.resultIndex;i<e.results.length;i++){
      if(e.results[i].isFinal)finalText+=e.results[i][0].transcript; else interim+=e.results[i][0].transcript;}
    $('status').textContent='🎙 '+(finalText+interim||'正在听…'); };
  rec.onerror=e=>{ stopUI();
    if(e.error==='not-allowed'||e.error==='service-not-allowed')
      $('status').textContent='⚠️ 麦克风权限被禁用。若在 Claude 预览中，请下载文件后用 Chrome 打开';
    else if(e.error==='no-speech')$('status').textContent='没听到声音，再试一次吧';
    else $('status').textContent='麦克风出了点问题：'+e.error; };
  rec.onend=()=>{ stopUI(); const t=finalText.trim();
    if(t)sendUser(t); else if(!busy&&!$('status').textContent.startsWith('⚠️'))$('status').textContent='没听清，请再说一次'; };
  try{ rec.start(); }catch(e){ $('status').textContent='启动麦克风失败，请刷新重试'; return; }
  listening=true;
  $('mic').classList.add('listening'); $('tile-me').classList.add('listening');
  $('status').textContent='正在听…请说英语';
}
function stopListen(){ if(rec&&listening){try{rec.stop();}catch(e){}} }
function stopUI(){ listening=false; $('mic').classList.remove('listening'); $('tile-me').classList.remove('listening'); }

