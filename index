/* ================== 提示词与模型调用 ================== */
function sysPrompt(){
  return `You are Ms. Emma, a warm and patient English teacher from London, talking with a Chinese middle school student (about 1500-word vocabulary, CEFR A1-A2).
Topic: ${cur.en}. Guiding questions you should work through one by one: ${cur.q.join(' | ')}. Key vocabulary to naturally use: ${cur.v}.
RULES:
1. Keep every reply SHORT: at most 2 simple sentences, then ALWAYS end with ONE question to the student.
2. Use simple words a Chinese middle schooler knows. British English style.
3. Be encouraging. If the student's sentence has a grammar/word error, gently include the correct form in your reply (e.g. "Lovely! We say 'sunny days'.") — at most ONE correction per turn.
4. If the student seems stuck or answers with very few words, offer a choice to help: "You can say: I like ... or I don't like ...".
5. The student's text comes from speech recognition, so ignore small transcription noise; if a word looks badly mispronounced (nonsense word), kindly ask them to repeat it after you.
6. When you receive [TIME_UP], warmly end the chat in 1-2 sentences (no question), set "end" true, and write "summary_cn": a friendly 2-3 sentence Chinese summary for the student (praise + what to review).
7. Respond with ONLY a JSON object, no markdown fences:
{"reply":"<what you say>","correction":{"original":"...","better":"...","note_cn":"<一句中文说明>"} or null,"end":false,"summary_cn":""}`;
}
async function rawCall(msgs,system){
  if(CONFIG.provider==='claude'){
    const r=await fetch('https://api.anthropic.com/v1/messages',{method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:1000,system,messages:msgs})});
    if(!r.ok)throw new Error(IN_CLAUDE?('服务暂时不可用（HTTP '+r.status+'），稍后重试'):'已脱离 Claude 环境：请到「家长管理 → AI 接口设置」改用 DeepSeek 并填入 key');
    const d=await r.json();
    return (d.content||[]).filter(b=>b.type==='text').map(b=>b.text).join('');
  }
  if(!CONFIG.apiKey)throw new Error('未填写 API key：请到「家长管理 → AI 接口设置」配置');
  const r=await fetch(CONFIG.apiBase,{method:'POST',
    headers:{'Content-Type':'application/json','Authorization':'Bearer '+CONFIG.apiKey},
    body:JSON.stringify({model:CONFIG.model,messages:[{role:'system',content:system},...msgs]})});
  if(!r.ok){let msg='';try{const j=await r.json();msg=(j.error&&j.error.message)||'';}catch(e){}
    throw new Error('接口返回 HTTP '+r.status+(r.status===401?'（key 无效或未填对）':'')+' '+msg);}
  const d=await r.json();
  return d.choices[0].message.content;
}
function callLLM(msgs){ return rawCall(msgs,sysPrompt()); }

