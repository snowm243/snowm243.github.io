  <path d="M56 88 h8 v8 l-4 4 -4 -4 Z" fill="#F6C9A0"/>
  <path d="M24 56 Q22 20 60 18 Q98 20 96 56 Q98 74 88 78 L86 60 Q84 40 60 40 Q36 40 34 60 L32 78 Q22 74 24 56 Z" fill="#6B4A36"/>
  <circle cx="60" cy="62" r="30" fill="#F6C9A0"/>
  <path d="M32 54 Q36 34 60 34 Q84 34 88 54 Q76 48 60 48 Q44 48 32 54 Z" fill="#6B4A36"/>
  <circle cx="30" cy="62" r="5" fill="#F6C9A0"/>
  <circle cx="90" cy="62" r="5" fill="#F6C9A0"/>
  <circle cx="90" cy="70" r="2.4" fill="#F2C14E"/>
  <circle cx="30" cy="70" r="2.4" fill="#F2C14E"/>
  <circle cx="48" cy="62" r="3.6" fill="#332723"/>
  <circle cx="72" cy="62" r="3.6" fill="#332723"/>
  <circle cx="49.4" cy="60.6" r="1.1" fill="#fff"/>
  <circle cx="73.4" cy="60.6" r="1.1" fill="#fff"/>
  <path d="M42 54 Q48 50 54 53" stroke="#4A3428" stroke-width="2" fill="none" stroke-linecap="round"/>
