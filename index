  $('custom-list').innerHTML=customTopics.length
   ? customTopics.map(t=>`<div class="custom-item"><span>${t.emo} ${esc(t.en)} · ${esc(t.cn)}（${t.min}分钟）</span>
      <button class="del" onclick='delTopic("${t.id}")'>删除</button></div>`).join('')
   : '<p class="sub">还没有自定义话题</p>';
}

/* ================== 启动 ================== */
(async()=>{ $('home-ava').innerHTML=EMMA_SVG; await loadApiCfg(); updateKeyWarn(); await loadCustom(); renderHome(); })();
</script>
</body>
</html>


